#set profiler=1

#include "../support/schedules/appliance_schedules_mod.glm";

#include "../support/schedules/water_and_setpoint_schedule_v5.glm";

#include "../support/schedules/commercial_schedules.glm";

#set minimum_timestep=60;

#set relax_naming_rules=1;

#set warn=0;

#define INVERTER_MODE=CONSTANT_PQ

#define INV_VBASE=240.0

#define INV_V1=0.92

#define INV_V2=0.98

#define INV_V3=1.02

#define INV_V4=1.08

#define INV_Q1=0.44

#define INV_Q2=0.00

#define INV_Q3=0.00

#define INV_Q4=-0.44

#define INV_VIN=200.0

#define INV_IIN=32.5

#define INV_VVLOCKOUT=300.0

#define INV_VW_V1=1.05 // 1.05833

#define INV_VW_V2=1.10

#define INV_VW_P1=1.0

#define INV_VW_P2=0.0

#ifdef WANT_VI_DUMP

#endif

#ifdef USE_HELICS

#endif


clock {
	timezone CST+6CDT;
	starttime '2021-08-05 00:00:00';
	stoptime '2021-08-06 00:00:00';
}

module tape;

module powerflow {
	lu_solver "KLU";
	solver_method FBS;
	default_maximum_voltage_error 0.01;
};

module climate;

module generators;

module connection;

module residential {
	implicit_enduses NONE;
};

class player {
	double value;
};

object metrics_collector_writer {
	name metrics_collector_1;
	interval 300;
	interim 7200;
	filename outputs/sim_metrics_;
}

object csv_reader {
	name csv_reader_obj;
	filename "../support/weather/Bronte2021_LST_CSV.csv";
}

object climate {
	name weather_Substation_2;
	tmyfile "../support/weather/Bronte2021_LST_CSV.csv";
	reader csv_reader_obj;
	interpolate QUADRATIC;
	latitude 29.65;
	longitude -95.42;
	tz_meridian -90.00;
}

object transformer_configuration {
	name feeder1_XF1_POLETOP_CS_200p0;
	power_rating 200.00;
	powerA_rating 0.0;
	powerB_rating 0.0;
	powerC_rating 200.00;
