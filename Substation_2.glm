clock {
  timezone EST+5EDT;
  starttime '2022-07-09 00:00:00';
  stoptime '2022-07-11 00:00:00';
}
#set profiler=1
module tape;
module powerflow{
  lu_solver "KLU";
     solver_method FBS;
       default_maximum_voltage_error 0.01;
};
module climate;
module generators;
module connection;
module residential {
  implicit_enduses NONE;
};
#include "support/schedules/appliance_schedules_mod.glm";
#include "support/schedules/water_and_setpoint_schedule_v5.glm";
#include "support/schedules/commercial_schedules.glm";
#set minimum_timestep=30;
#set relax_naming_rules=1;
#set warn=0;
object metrics_collector_writer {
  interval 300;
  interim 7200;
  filename ${METRICS_FILE};
  // filename your_metrics;
  alternate yes;
  extension h5;
};
object climate {
  name weather_Substation_2;
  // tmyfile "../../support/weather/weather_Bus_2_Newport.dat";
  interpolate QUADRATIC;
  latitude 29.65;
  longitude -95.42;
  tz_meridian -90.00;
};
#ifdef WANT_VI_DUMP
object voltdump {
  filename Voltage_Dump_Substation_2.csv;
  mode polar;
}
object currdump {
  filename Current_Dump_Substation_2.csv;
  mode polar;
}
#endif
  object group_recorder {
    name EV_charger_recorder_R2_12_47_3;
    group "class=evcharger_det";
    property realized_charge_rate;
    file EV_charger_outputR2_12_47_3.csv;
    interval 300;
  };
